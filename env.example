# Copy this file to ".env" and fill in your values

# Kafka broker address
KAFKA_BOOTSTRAP_SERVERS=
# Topic where events will be stored
KAFKA_TOPIC=

# Only needed for cloud Kafka (Confluent Cloud, etc.). Leave empty for local Kafka.
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Seconds to wait between events
EVENT_INTERVAL_SECONDS=1
